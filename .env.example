# ============================================================
# Ask Builder — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit a real .env file to version control.
# ============================================================

# ── AI Provider ──────────────────────────────────────────────

# Your Google Gemini API key (server-side only — never expose to client)
GEMINI_API_KEY=

# Model identifier — Gemini 2.5 Flash (current production model)
AI_MODEL=gemini-2.5-flash

# ── Provider Mode ─────────────────────────────────────────────
# When GEMINI_API_KEY is empty or unset, Ask Builder automatically
# uses the MockAIProvider (deterministic responses, no API call).
# Set GEMINI_API_KEY to switch to the real Gemini provider.

# ── Notes ────────────────────────────────────────────────────
# 1. GEMINI_API_KEY must remain server-side only.
#    Do NOT add it to any client-side script, public HTML, or
#    commit it to the repository.
# 2. The mock provider is always available as a fallback —
#    Ask Builder works fully without a real API key in dev mode.
# 3. For production deployment, set GEMINI_API_KEY in your hosting
#    environment's secret manager (Vercel / Netlify / Railway, etc.)
