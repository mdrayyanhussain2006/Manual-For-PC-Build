# ============================================================
# Ask Builder — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit a real .env file to version control.
# ============================================================

# ── AI Provider ──────────────────────────────────────────────

# Your Google Gemini API key (server-side only — never expose to client)
# Get one at https://aistudio.google.com/apikey
AI_API_KEY=

# Gemini API base URL (do not change unless using a proxy)
AI_BASE_URL=https://generativelanguage.googleapis.com

# Stable Gemini model identifier for web app use
AI_MODEL=gemini-2.5-flash

# ── Provider Mode ─────────────────────────────────────────────
# When AI_API_KEY is empty or unset, Ask Builder automatically
# uses MockAIProvider (deterministic responses, no API call).
# Set AI_API_KEY to a valid Gemini key to switch to live mode.

# ── NVIDIA Provider (optional; takes priority over Gemini) ───
# Add this variable in Vercel Project Settings for live NVIDIA replies.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# ── Notes ────────────────────────────────────────────────────
# 1. AI_API_KEY must remain server-side only.
#    Do NOT add it to any client-side script, public HTML, or
#    commit it to the repository.
# 2. The mock provider is always available as a fallback —
#    Ask Builder works fully without a real API key in dev mode.
# 3. For production deployment, set AI_API_KEY in your hosting
#    environment's secret manager (Vercel / Netlify / Railway, etc.)
