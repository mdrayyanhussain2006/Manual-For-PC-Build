# ============================================================
# Ask Builder — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit a real .env file to version control.
# ============================================================

# ── AI Provider ──────────────────────────────────────────────

# Your DeepSeek API key (server-side only — never expose to client)
AI_API_KEY=

# DeepSeek API base URL (do not change unless using a proxy)
AI_BASE_URL=https://api.deepseek.com

# Model identifier — DeepSeek V4 Pro (current production model)
AI_MODEL=deepseek-chat

# ── Provider Mode ─────────────────────────────────────────────
# When AI_API_KEY is empty or unset, Ask Builder automatically
# uses the MockAIProvider (deterministic responses, no API call).
# Set AI_API_KEY to switch to the real DeepSeek provider.

# ── Notes ────────────────────────────────────────────────────
# 1. AI_API_KEY must remain server-side only.
#    Do NOT add it to any client-side script, public HTML, or
#    commit it to the repository.
# 2. The mock provider is always available as a fallback —
#    Ask Builder works fully without a real API key in dev mode.
# 3. For production deployment, set AI_API_KEY in your hosting
#    environment's secret manager (Vercel / Netlify / Railway, etc.)
