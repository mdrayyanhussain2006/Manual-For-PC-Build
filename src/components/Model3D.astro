---
// ============================================================
// FILE: src/components/Model3D.astro
// Core 3D Solo Component Viewer — Powered by SoloComponentAdapter
// Loads real GLB assets, supports Explode, X-Ray, Annotations, and Camera Framing
// ============================================================
import { getComponentBySlug, ROUTE_ALIASES } from '../lib/3d/ComponentRegistry';

interface Props {
  /** Canonical slug or alias (e.g. 'motherboard', 'gpu', 'ram', 'cpu', etc.) */
  slug?: string;
  /** Legacy geometry key support */
  geometry?: string;
  /** Descriptive aria-label applied to the rendered canvas */
  label?: string;
  /** Initial LOD level */
  lod?: 0 | 1;
  /** Extra class names */
  class?: string;
}

const {
  slug: rawSlug,
  geometry,
  label = 'Interactive 3D component model',
  lod = 0,
  class: className = '',
} = Astro.props;

const targetSlug = rawSlug || geometry || 'ram';
const canonicalSlug = ROUTE_ALIASES[targetSlug] || targetSlug;
const metadata = getComponentBySlug(canonicalSlug);
---

<div
  class={`relative flex flex-col rounded-card border border-primary/10 bg-surface-raised overflow-hidden ${className}`}
  data-solo-viewer
  data-slug={canonicalSlug}
  data-lod={lod}
>
  <!-- Top Toolbar -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-primary/10 bg-surface/80 px-4 py-2.5 backdrop-blur-md z-20">
    <div class="flex items-center gap-2">
      <span class="size-2 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
      <span class="font-mono text-xs font-medium text-primary uppercase tracking-wider">
        {metadata?.displayName || canonicalSlug}
      </span>
    </div>

    <div class="flex items-center gap-4 text-xs text-secondary">
      {metadata?.supportedFeatures.explode && (
        <div class="flex items-center gap-2">
          <label for={`explode-${canonicalSlug}`} class="font-mono text-[11px]">Explode</label>
          <input
            id={`explode-${canonicalSlug}`}
            type="range"
            min="0"
            max="1"
            step="0.01"
            value="0"
            class="w-20 sm:w-28 accent-accent cursor-pointer h-1.5 bg-primary/20 rounded-lg appearance-none"
            data-ctrl-explode
            aria-label="Explode 3D parts"
          />
        </div>
      )}

      {metadata?.supportedFeatures.xray && (
        <label class="flex items-center gap-1.5 cursor-pointer select-none">
          <input
            type="checkbox"
            class="size-3.5 rounded border-primary/20 text-accent focus:ring-accent accent-accent cursor-pointer"
            data-ctrl-xray
          />
          <span class="font-mono text-[11px]">X-Ray</span>
        </label>
      )}

      <button
        type="button"
        class="rounded border border-primary/10 bg-surface px-2.5 py-1 font-mono text-[11px] text-secondary hover:text-primary hover:border-primary/30 transition-colors"
        data-ctrl-reset
      >
        Reset view
      </button>
    </div>
  </div>

  <!-- Main 3D Stage -->
  <div class="relative aspect-[4/3] w-full select-none overflow-hidden bg-surface-raised" data-stage-host>
    <!-- WebGL Canvas -->
    <canvas
      class="absolute inset-0 size-full block touch-none focus:outline-none"
      role="img"
      aria-label={label}
      tabindex="0"
      data-stage-canvas
    ></canvas>

    <!-- HTML Badges Overlay Container -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-10" data-badges-container></div>

    <!-- Loading Skeleton Overlay -->
    <div
      class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-surface-raised/90 backdrop-blur-sm z-30 transition-opacity duration-300"
      data-stage-loading
    >
      <div class="size-8 rounded-full border-2 border-primary/20 border-t-accent animate-spin"></div>
      <p class="font-mono text-xs text-secondary" data-loading-text>Loading 3D asset…</p>
    </div>

    <!-- Interaction Hint -->
    <div class="absolute bottom-3 left-3 pointer-events-none rounded bg-surface/80 px-2.5 py-1 font-mono text-[10px] text-secondary backdrop-blur-sm z-20">
      Drag to rotate · Scroll to zoom · Click pins for details
    </div>
  </div>

  <!-- Selected Part Details Tray -->
  <div class="border-t border-primary/10 bg-surface p-5 transition-all duration-300" data-details-tray>
    <div class="flex flex-col gap-4" data-details-content>
      <!-- Title Header -->
      <div class="flex items-center gap-3">
        <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-accent text-surface font-mono text-xs font-bold shadow-md" data-part-chip>
          --
        </div>
        <h3 class="text-base font-semibold text-primary" data-part-title>
          Select an annotation pin or part
        </h3>
      </div>

      <!-- Initial / Empty placeholder hint -->
      <p class="text-xs text-secondary leading-relaxed" data-part-initial-hint>
        Click any numbered badge in the 3D viewer or part geometry to inspect its technical role, function, and specifications.
      </p>

      <!-- Educational Breakdown (Hidden until part selected) -->
      <div class="hidden flex flex-col gap-3.5 pt-1" data-part-sections>
        <!-- WHAT IT IS -->
        <div data-section-what-is>
          <div class="font-mono text-[10px] font-bold text-accent uppercase tracking-wider">WHAT IT IS</div>
          <p class="mt-1 text-xs text-primary leading-relaxed" data-part-description></p>
        </div>

        <!-- WHAT IT DOES -->
        <div data-section-what-does>
          <div class="font-mono text-[10px] font-bold text-accent uppercase tracking-wider">WHAT IT DOES</div>
          <p class="mt-1 text-xs text-secondary leading-relaxed" data-part-function></p>
        </div>

        <!-- WHY IT MATTERS -->
        <div data-section-why-matters>
          <div class="font-mono text-[10px] font-bold text-accent uppercase tracking-wider">WHY IT MATTERS</div>
          <p class="mt-1 text-xs text-secondary leading-relaxed" data-part-importance></p>
        </div>

        <!-- KEY FACTS -->
        <div data-section-key-facts>
          <div class="font-mono text-[10px] font-bold text-accent uppercase tracking-wider">KEY FACTS</div>
          <ul class="mt-1.5 list-disc list-inside text-xs text-secondary space-y-1" data-part-facts></ul>
        </div>
      </div>
    </div>
  </div>

  <noscript>
    <p class="p-6 text-sm text-secondary">
      3D preview requires JavaScript — see the specifications on this page for details.
    </p>
  </noscript>
</div>

<style is:global>
  /* Badge styling strictly scoped to 3D DOM overlays */
  .badge-anchor {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px;
    border-radius: 9999px;
    min-width: 24px;
    height: 24px;
    background: rgba(14, 20, 32, 0.85);
    backdrop-filter: blur(8px);
    border: 1.5px solid var(--theme-accent, #38bdf8);
    color: #f8fafc;
    cursor: pointer;
    pointer-events: auto;
    user-select: none;
    box-shadow: 0 0 10px var(--theme-accent-glow, rgba(56, 189, 248, 0.4)), 0 2px 8px rgba(0, 0, 0, 0.4);
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    white-space: nowrap;
    z-index: 10;
  }

  .badge-anchor:hover {
    transform: translate(-50%, -50%) scale(1.1);
    background: #0f172a;
    border-color: var(--theme-accent, #38bdf8);
    box-shadow: 0 0 16px var(--theme-accent-glow-hover, rgba(56, 189, 248, 0.7));
  }

  .badge-anchor .badge-chip {
    width: 18px;
    height: 18px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-weight: 700;
    font-size: 10px;
    color: #040817;
    background: var(--theme-accent, #38bdf8);
    flex-shrink: 0;
  }

  .badge-anchor .badge-label {
    display: none;
    font-size: 11px;
    font-weight: 600;
    padding: 0 8px 0 4px;
    color: #ffffff;
    letter-spacing: 0.02em;
  }

  .badge-anchor.active {
    border-radius: 9999px;
    padding: 3px 10px 3px 3px;
    gap: 6px;
    border-color: var(--theme-accent, #38bdf8);
    background: rgba(14, 20, 32, 0.95);
    box-shadow: 0 0 20px var(--theme-accent-glow-active, rgba(56, 189, 248, 0.75)), inset 0 0 10px var(--theme-accent-glow-inset, rgba(56, 189, 248, 0.2));
    z-index: 20;
  }

  .badge-anchor.active .badge-label {
    display: inline;
  }

  /* Theme-specific accent colors */
  [data-theme="light"] .badge-anchor {
    --theme-accent: #2563EB;
    --theme-accent-glow: rgba(37, 99, 235, 0.4);
    --theme-accent-glow-hover: rgba(37, 99, 235, 0.7);
    --theme-accent-glow-active: rgba(37, 99, 235, 0.75);
    --theme-accent-glow-inset: rgba(37, 99, 235, 0.2);
  }

  [data-theme="dark"] .badge-anchor {
    --theme-accent: #5B8DEF;
    --theme-accent-glow: rgba(91, 141, 239, 0.4);
    --theme-accent-glow-hover: rgba(91, 141, 239, 0.7);
    --theme-accent-glow-active: rgba(91, 141, 239, 0.75);
    --theme-accent-glow-inset: rgba(91, 141, 239, 0.2);
  }

  [data-theme="accent"] .badge-anchor {
    --theme-accent: #edff45;
    --theme-accent-glow: rgba(237, 255, 69, 0.4);
    --theme-accent-glow-hover: rgba(237, 255, 69, 0.7);
    --theme-accent-glow-active: rgba(237, 255, 69, 0.75);
    --theme-accent-glow-inset: rgba(237, 255, 69, 0.2);
    background: rgba(0, 0, 242, 0.95);
    border-color: #edff45;
  }

  [data-theme="accent"] .badge-anchor:hover {
    background: #0000f2;
    border-color: #edff45;
    box-shadow: 0 0 20px rgba(237, 255, 69, 0.8);
  }

  [data-theme="accent"] .badge-anchor.active {
    background: rgba(0, 0, 242, 0.98);
    border-color: #edff45;
    box-shadow: 0 0 24px rgba(237, 255, 69, 0.9), inset 0 0 12px rgba(237, 255, 69, 0.3);
  }

  [data-theme="accent"] .badge-anchor .badge-chip {
    background: #edff45;
    color: #0000f2;
  }

  [data-theme="accent"] .badge-anchor .badge-label {
    color: #f5f5f5;
  }
</style>

<script>
  import { SoloComponentAdapter } from '../lib/3d/SoloComponentAdapter';

  function initSoloViewers() {
    const viewers = document.querySelectorAll<HTMLElement>('[data-solo-viewer]');

    viewers.forEach((root) => {
      if ((root as any).__solo_adapter) return;

      const slug = root.dataset.slug || 'ram';
      const lod = (parseInt(root.dataset.lod || '0', 10) as 0 | 1) || 0;

      const hostElement = root.querySelector<HTMLElement>('[data-stage-host]');
      const canvas = root.querySelector<HTMLCanvasElement>('[data-stage-canvas]');
      const badgesContainer = root.querySelector<HTMLElement>('[data-badges-container]');
      const loadingOverlay = root.querySelector<HTMLElement>('[data-stage-loading]');
      const loadingText = root.querySelector<HTMLElement>('[data-loading-text]');

      const explodeInput = root.querySelector<HTMLInputElement>('[data-ctrl-explode]');
      const xrayCheckbox = root.querySelector<HTMLInputElement>('[data-ctrl-xray]');
      const resetBtn = root.querySelector<HTMLButtonElement>('[data-ctrl-reset]');

      const partChip = root.querySelector<HTMLElement>('[data-part-chip]');
      const partTitle = root.querySelector<HTMLElement>('[data-part-title]');

      if (!hostElement || !canvas) return;

      const adapter = new SoloComponentAdapter({
        hostElement,
        canvas,
        slug,
        lod,
        badgesContainer: badgesContainer || undefined,
        onLoadProgress: (ratio) => {
          if (loadingText && ratio !== null) {
            loadingText.textContent = `Loading 3D asset… ${Math.round(ratio * 100)}%`;
          }
        },
        onReady: () => {
          if (loadingOverlay) {
            loadingOverlay.style.opacity = '0';
            setTimeout(() => {
              loadingOverlay.style.display = 'none';
            }, 300);
          }
        },
        onError: (err) => {
          if (loadingText) {
            loadingText.textContent = `Failed to load 3D model: ${err.message}`;
            loadingText.classList.add('text-danger');
          }
        },
        onPartSelect: (partNum, partData) => {
          const initialHint = root.querySelector<HTMLElement>('[data-part-initial-hint]');
          const sections = root.querySelector<HTMLElement>('[data-part-sections]');
          const descEl = root.querySelector<HTMLElement>('[data-part-description]');
          const funcEl = root.querySelector<HTMLElement>('[data-part-function]');
          const impEl = root.querySelector<HTMLElement>('[data-part-importance]');
          const factsEl = root.querySelector<HTMLElement>('[data-part-facts]');

          if (partNum && partData) {
            if (partChip) partChip.textContent = partNum;
            if (partTitle) partTitle.textContent = partData.title;

            if (initialHint) initialHint.classList.add('hidden');
            if (sections) sections.classList.remove('hidden');

            if (descEl) descEl.textContent = partData.description || partData.summary || 'Hardware component module.';
            if (funcEl) {
              const sec = funcEl.closest('[data-section-what-does]') as HTMLElement | null;
              if (partData.function || partData.role) {
                funcEl.textContent = partData.function || partData.role;
                if (sec) sec.classList.remove('hidden');
              } else if (sec) {
                sec.classList.add('hidden');
              }
            }
            if (impEl) {
              const sec = impEl.closest('[data-section-why-matters]') as HTMLElement | null;
              if (partData.importance) {
                impEl.textContent = partData.importance;
                if (sec) sec.classList.remove('hidden');
              } else if (sec) {
                sec.classList.add('hidden');
              }
            }
            if (factsEl) {
              const sec = factsEl.closest('[data-section-key-facts]') as HTMLElement | null;
              factsEl.replaceChildren();
              const factsList = Array.isArray(partData.facts) ? partData.facts : (Array.isArray(partData.specs) ? partData.specs : []);
              if (factsList.length > 0) {
                for (const fact of factsList) {
                  const li = document.createElement('li');
                  li.textContent = fact;
                  factsEl.appendChild(li);
                }
                if (sec) sec.classList.remove('hidden');
              } else if (sec) {
                sec.classList.add('hidden');
              }
            }
          } else {
            if (partChip) partChip.textContent = '--';
            if (partTitle) partTitle.textContent = 'Select an annotation pin or part';
            if (initialHint) initialHint.classList.remove('hidden');
            if (sections) sections.classList.add('hidden');
          }
        },
      });

      explodeInput?.addEventListener('input', () => {
        adapter.setExplode(parseFloat(explodeInput.value));
      });

      xrayCheckbox?.addEventListener('change', () => {
        adapter.setXray(xrayCheckbox.checked);
      });

      resetBtn?.addEventListener('click', () => {
        adapter.resetView();
        if (explodeInput) {
          explodeInput.value = '0';
          adapter.setExplode(0);
        }
        if (xrayCheckbox) {
          xrayCheckbox.checked = false;
          adapter.setXray(false);
        }
        adapter.selectPart(null);
      });

      (root as any).__solo_adapter = adapter;
      adapter.initialize();
    });
  }

  // Watch for theme changes and update 3D scene materials
  function setupThemeObserver() {
    const rootEl = document.documentElement;
    
    // Apply initial theme to all viewers
    const applyThemeToViewers = () => {
      const viewers = document.querySelectorAll<HTMLElement>('[data-solo-viewer]');
      const currentTheme = rootEl.getAttribute('data-theme') || 'light';
      
      viewers.forEach((root) => {
        const adapter = (root as any).__solo_adapter;
        if (adapter && typeof adapter.updateTheme === 'function') {
          adapter.updateTheme(currentTheme);
        }
      });
    };

    // Observe changes to data-theme attribute
    const observer = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
          applyThemeToViewers();
          break;
        }
      }
    });

    observer.observe(rootEl, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    // Apply theme immediately
    applyThemeToViewers();
  }

  // Support initial load and Astro client-side navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initSoloViewers();
      setupThemeObserver();
      setupFocusFeatureListener();
    });
  } else {
    initSoloViewers();
    setupThemeObserver();
    setupFocusFeatureListener();
  }

  document.addEventListener('astro:page-load', () => {
    initSoloViewers();
    setupThemeObserver();
    setupFocusFeatureListener();
  });

  // ── Ask Builder focusFeature integration ──────────────────────
  // Listens for ask-builder:focus-feature events and routes them to the
  // correct SoloComponentAdapter instance by matching semanticId to part number.
  function setupFocusFeatureListener(): void {
    if ((window as any).__ab_focus_listener_attached) return;
    (window as any).__ab_focus_listener_attached = true;

    window.addEventListener('ask-builder:focus-feature', ((e: CustomEvent) => {
      const { component, semanticId } = e.detail ?? {};
      if (!component || !semanticId) return;

      const viewers = document.querySelectorAll<HTMLElement>('[data-solo-viewer]');
      for (const root of viewers) {
        if (root.dataset.slug !== component) continue;
        const adapter = (root as any).__solo_adapter;
        if (!adapter) continue;

        // Find part number by semanticId
        const parts = adapter.parts; // PartInfo[]
        const match = parts.find((p: any) => p.id === semanticId);
        if (match) {
          adapter.selectPart(match.number, true);
        }
        break;
      }
    }) as EventListener);
  }
</script>
