---
// ============================================================
// FILE: src/components/Callout.astro
// Phase 0 — reusable callout: note / caution / danger.
// Each variant is distinguished by color token AND inline SVG
// icon AND a text label — never by color alone.
// ============================================================
interface Props {
  variant?: 'note' | 'caution' | 'danger';
  title?: string;
}

const { variant = 'note', title } = Astro.props;

const variants = {
  note: {
    defaultTitle: 'Note',
    role: 'note',
    container: 'border-accent/40 bg-accent/5',
    emphasis: 'text-accent',
  },
  caution: {
    defaultTitle: 'Caution',
    role: 'note',
    container: 'border-caution/40 bg-caution/5',
    emphasis: 'text-caution',
  },
  danger: {
    defaultTitle: 'Warning',
    role: 'alert',
    container: 'border-danger/40 bg-danger/5',
    emphasis: 'text-danger',
  },
} as const;

const v = variants[variant];
---

<aside
  role={v.role}
  class:list={['flex items-start gap-3 rounded-card border p-4', v.container]}
>
  <svg
    class:list={['mt-0.5 size-5 shrink-0', v.emphasis]}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    {variant === 'note' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 11v5" />
        <path d="M12 8h.01" />
      </>
    )}
    {variant === 'caution' && (
      <>
        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
        <path d="M12 9v4" />
        <path d="M12 17h.01" />
      </>
    )}
    {variant === 'danger' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="m9 9 6 6" />
        <path d="m15 9-6 6" />
      </>
    )}
  </svg>

  <div class="min-w-0 flex-1">
    <p class:list={['text-sm font-medium', v.emphasis]}>
      {title ?? v.defaultTitle}
    </p>
    <div class="mt-1 text-sm text-primary">
      <slot />
    </div>
  </div>
</aside>
