---
// ============================================================
// FILE: src/layouts/BaseLayout.astro
// Base shell: header/nav, footer, content slot, 3-mode theme switcher
// ============================================================
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'PC Customization Manual',
  description = 'A documentation-style manual for customizing and building a personal computer.',
} = Astro.props;

const navItems = [
  { label: 'Landing', href: '/' },
  { label: 'Get ready', href: '/get-ready/' },
  { label: 'Component library', href: '/components/' },
  { label: 'Guided build', href: '/build/' },
  { label: 'Troubleshooting', href: '/troubleshooting/' },
];

const currentPath = Astro.url.pathname;

function isCurrent(href: string) {
  return href === '/' ? currentPath === '/' : currentPath.startsWith(href);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Fonts -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/geist-sans@5/400.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/geist-sans@5/500.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/geist-mono@5/400.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/geist-mono@5/500.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/orbitron@5/700.css" />

    <!-- Apply theme classes before first paint (no flash of unstyled theme) -->
    <script is:inline>
      (function () {
        try {
          document.documentElement.classList.add('no-transition');
          var stored = localStorage.getItem('pc-manual-theme');
          var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.classList.toggle('dark', theme === 'dark' || theme === 'accent');
          requestAnimationFrame(function() {
            requestAnimationFrame(function() {
              document.documentElement.classList.remove('no-transition');
            });
          });
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="flex min-h-dvh flex-col bg-surface font-sans text-base text-primary">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-6 focus:top-6 focus:z-50 focus:rounded-card focus:bg-surface-raised focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-accent"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-40 border-b border-primary/10 bg-surface/90 backdrop-blur-md">
      <div class="mx-auto w-full max-w-content px-6">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 py-3">
          <!-- Wordmark -->
          <a href="/" class="flex items-center gap-2 rounded-card py-1">
            <span
              aria-hidden="true"
              class="grid size-7 place-items-center rounded-badge bg-accent font-mono text-xs font-medium text-surface transition-colors"
            >
              PC
            </span>
            <span class="text-sm font-medium">PC Customization Manual</span>
          </a>

          <!-- Canonical 3-State Theme Switcher -->
          <div class="order-2 ml-auto flex items-center gap-2 md:order-3 md:ml-0">
            <div
              class="flex items-center rounded-card border border-primary/10 bg-surface-raised p-0.5 text-xs font-mono select-none"
              role="group"
              aria-label="Theme mode"
            >
              <button
                type="button"
                data-theme-set="light"
                aria-pressed="false"
                class="rounded-[6px] px-2.5 py-1 text-secondary transition-all hover:text-primary aria-pressed:bg-surface aria-pressed:font-medium aria-pressed:text-accent aria-pressed:shadow-sm cursor-pointer"
                aria-label="Light mode"
              >
                Light
              </button>
              <button
                type="button"
                data-theme-set="dark"
                aria-pressed="false"
                class="rounded-[6px] px-2.5 py-1 text-secondary transition-all hover:text-primary aria-pressed:bg-surface aria-pressed:font-medium aria-pressed:text-accent aria-pressed:shadow-sm cursor-pointer"
                aria-label="Dark mode"
              >
                Dark
              </button>
              <button
                type="button"
                data-theme-set="accent"
                aria-pressed="false"
                class="rounded-[6px] px-2.5 py-1 text-secondary transition-all hover:text-primary aria-pressed:bg-surface aria-pressed:font-medium aria-pressed:text-accent aria-pressed:shadow-sm cursor-pointer"
                aria-label="Accent mode"
              >
                Accent
              </button>
            </div>
          </div>

          <!-- Primary nav: wraps onto its own row on small screens (no overflow at 375px) -->
          <nav aria-label="Primary" class="order-3 -mx-1 w-full md:order-2 md:mx-0 md:ml-auto md:w-auto">
            <ul class="flex flex-wrap items-center gap-1 text-sm">
              {navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                    class:list={[
                      'block rounded-card px-3 py-1.5 text-secondary transition-colors hover:bg-surface-raised hover:text-primary',
                      { 'bg-surface-raised font-medium text-accent': isCurrent(item.href) },
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Footer with version/changelog stub -->
    <footer class="border-t border-primary/10 bg-surface">
      <div class="mx-auto flex w-full max-w-content flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-4 text-sm text-secondary">
        <p>
          PC Customization Manual <span aria-hidden="true">·</span>
          <span class="font-mono text-xs">v1.0.0</span>
        </p>
        <div class="flex items-center gap-4 text-xs font-mono">
          <span class="text-secondary">Interactive 3D Hardware Anatomy</span>
        </div>
      </div>
    </footer>

    <script>
      function initThemeSwitcher() {
        const rootEl = document.documentElement;
        const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-set]'));

        const syncButtons = () => {
          const current = rootEl.getAttribute('data-theme') || (rootEl.classList.contains('dark') ? 'dark' : 'light');
          for (const btn of buttons) {
            const mode = btn.dataset.themeSet;
            btn.setAttribute('aria-pressed', String(mode === current));
          }
        };

        for (const btn of buttons) {
          btn.addEventListener('click', () => {
            const mode = btn.dataset.themeSet || 'light';
            rootEl.setAttribute('data-theme', mode);
            rootEl.classList.toggle('dark', mode === 'dark' || mode === 'accent');
            localStorage.setItem('pc-manual-theme', mode);
            syncButtons();
            // Ensure transitions work after manual theme switch
            rootEl.classList.remove('no-transition');
          });
        }

        syncButtons();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initThemeSwitcher);
      } else {
        initThemeSwitcher();
      }

      document.addEventListener('astro:page-load', initThemeSwitcher);
    </script>
  </body>
</html>
