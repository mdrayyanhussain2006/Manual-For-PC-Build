---
// ============================================================
// FILE: src/pages/components/cpu/index.astro
// Phase 5 (CPU) — mirrors the Motherboard/Case page structure
// exactly (viewer 7/12 + specs 5/12 at md:).
// ============================================================
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatGroup from '../../../components/StatGroup.astro';
import Model3D from '../../../components/Model3D.astro';

const specs = [
  { label: 'Socket', value: 'LGA1700' },
  { label: 'Cores/Threads', value: '8/16' },
  { label: 'Base clock', value: '3.4 GHz' },
  { label: 'TDP', value: '65W' },
  { label: 'Integrated graphics', value: 'Yes' },
];
---

<BaseLayout title="CPU — Component library — PC Customization Manual">
  <article class="mx-auto w-full max-w-content px-6 py-12 md:py-16">
    <div class="grid grid-cols-12 gap-6">
      <header class="col-span-12">
        <p class="font-mono text-xs text-secondary">Component 2 of 8</p>
        <h1 class="mt-4 text-2xl font-medium md:text-3xl">CPU</h1>
        <p class="mt-4 max-w-2xl text-lg text-secondary">
          The CPU handles the actual computation for everything your PC does.
          It's also the most fragile component to install — proper alignment
          and a light touch matter more here than almost anywhere else in the
          build.
        </p>
      </header>

      <div class="col-span-12 md:col-span-7">
        <Model3D
          geometry="cpu"
          label="Stylized 3D model of a CPU showing the flat substrate, the integrated heat spreader sitting flush on top, and a small alignment-marker inset near one corner of the heat spreader"
        />
        <p class="mt-2 text-xs text-secondary">
          Drag to rotate · scroll or pinch to zoom
        </p>
      </div>

      <div class="col-span-12 md:col-span-5">
        <div class="rounded-card border border-primary/10 bg-surface-raised p-6">
          <p class="text-xs text-secondary">Example specifications</p>
          <div class="mt-4">
            <StatGroup stats={specs} />
          </div>
          <p class="mt-4 text-sm text-secondary">
            Specifications above are illustrative — refer to your specific
            processor's documentation for exact values.
          </p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
