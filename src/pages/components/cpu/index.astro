---
// ============================================================
// FILE: src/pages/components/cpu/index.astro
// CPU component page
// ============================================================
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatGroup from '../../../components/StatGroup.astro';
import Model3D from '../../../components/Model3D.astro';
import { getComponentBySlug, getAllComponents } from '../../../lib/3d/ComponentRegistry';

const metadata = getComponentBySlug('cpu')!;
const allComponents = getAllComponents();
const currentIndex = allComponents.findIndex((c) => c.slug === metadata.slug);
const indexDisplay = currentIndex !== -1 ? `${currentIndex + 1} of ${allComponents.length}` : '';
---

<BaseLayout title={`${metadata.displayName} — Component library — BuildForge Lab`}>
  <article class="mx-auto w-full max-w-content px-6 py-12 md:py-16">
    <div class="grid grid-cols-12 gap-6">
      <header class="col-span-12">
        <p class="font-mono text-xs text-secondary">Component {indexDisplay}</p>
        <h1 class="mt-4 text-2xl font-medium md:text-3xl">{metadata.displayName}</h1>
        <p class="mt-4 max-w-2xl text-lg text-secondary">
          {metadata.description} Proper socket alignment and zero-insertion-force seating ensure all delicate socket pins maintain flawless electrical contact.
        </p>
      </header>

      <div class="col-span-12 lg:col-span-7">
        <Model3D
          slug={metadata.slug}
          label={`3D model of ${metadata.displayName}`}
        />
      </div>

      <div class="col-span-12 lg:col-span-5">
        <div class="rounded-card border border-primary/10 bg-surface-raised p-6">
          <p class="text-xs font-mono uppercase tracking-wider text-secondary">Technical Specifications</p>
          <div class="mt-4">
            <StatGroup stats={metadata.specs ?? []} />
          </div>
          <p class="mt-4 text-sm text-secondary">
            Specifications above are illustrative — refer to your processor's documentation for exact base clock, boost limits, and memory channels.
          </p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
