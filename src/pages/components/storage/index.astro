---
// ============================================================
// FILE: src/pages/components/storage/index.astro
// Phase 11 (Storage — final component) — mirrors the established
// component-page structure exactly (viewer 7/12 + specs 5/12
// at md:). Copy transcribed character-for-character.
// ============================================================
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatGroup from '../../../components/StatGroup.astro';
import Model3D from '../../../components/Model3D.astro';

const specs = [
  { label: 'Type', value: 'M.2 NVMe SSD' },
  { label: 'Capacity', value: '1TB' },
  { label: 'Interface', value: 'PCIe 4.0 x4' },
  { label: 'Form factor', value: 'M.2 2280' },
  { label: 'Sequential read', value: 'Up to 7,000 MB/s' },
];
---

<BaseLayout title="Storage — Component library — PC Customization Manual">
  <article class="mx-auto w-full max-w-content px-6 py-12 md:py-16">
    <div class="grid grid-cols-12 gap-6">
      <header class="col-span-12">
        <p class="font-mono text-xs text-secondary">Component 8 of 8</p>
        <h1 class="mt-4 text-2xl font-medium md:text-3xl">Storage</h1>
        <p class="mt-4 max-w-2xl text-lg text-secondary">
          Storage is where your operating system, applications, and files actually
          live. M.2 drives install directly onto the motherboard rather than
          connecting via cables, which makes them fast to install but easy to get
          wrong if you rush the angle.
        </p>
      </header>

      <div class="col-span-12 md:col-span-7">
        <Model3D
          geometry="storage"
          label="Stylized 3D model of an M.2 NVMe storage drive showing the thin elongated PCB stick, the connector strip flush against one end, and the screw-mount marker on top of the PCB near the opposite end"
        />
        <p class="mt-2 text-xs text-secondary">
          Drag to rotate · scroll or pinch to zoom
        </p>
      </div>

      <div class="col-span-12 md:col-span-5">
        <div class="rounded-card border border-primary/10 bg-surface-raised p-6">
          <p class="text-xs text-secondary">Example specifications</p>
          <div class="mt-4">
            <StatGroup stats={specs} />
          </div>
          <p class="mt-4 text-sm text-secondary">
            Specifications above are illustrative — refer to your specific
            drive's documentation for exact values.
          </p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
