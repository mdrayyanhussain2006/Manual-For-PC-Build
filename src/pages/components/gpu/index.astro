---
// ============================================================
// FILE: src/pages/components/gpu/index.astro
// Phase 10 (GPU) — mirrors the established component-page
// structure exactly (viewer 7/12 + specs 5/12 at md:).
// Copy transcribed character-for-character from the prompt.
// ============================================================
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatGroup from '../../../components/StatGroup.astro';
import Model3D from '../../../components/Model3D.astro';

const specs = [
  { label: 'Memory', value: '12GB GDDR6' },
  { label: 'Interface', value: 'PCIe 4.0 x16' },
  { label: 'Slot width', value: '2.5 slots' },
  { label: 'Recommended PSU', value: '650W' },
  { label: 'Power connectors', value: '1× 8-pin' },
];
---

<BaseLayout title="GPU — Component library — PC Customization Manual">
  <article class="mx-auto w-full max-w-content px-6 py-12 md:py-16">
    <div class="grid grid-cols-12 gap-6">
      <header class="col-span-12">
        <p class="font-mono text-xs text-secondary">Component 7 of 8</p>
        <h1 class="mt-4 text-2xl font-medium md:text-3xl">GPU</h1>
        <p class="mt-4 max-w-2xl text-lg text-secondary">
          The GPU handles graphics rendering and, for many builds, is the
          single most expensive and heaviest component going in. Getting it
          seated fully and supported properly matters — a card that isn't fully
          clicked in can cause display issues that are easy to misdiagnose.
        </p>
      </header>

      <div class="col-span-12 md:col-span-7">
        <Model3D
          geometry="gpu"
          label="Stylized 3D model of a GPU showing the long thin PCB, the cooling shroud covering most of it, a fan disc on the shroud's top face, the PCIe connector strip along the bottom edge, and the power connector block near the back of the shroud"
        />
        <p class="mt-2 text-xs text-secondary">
          Drag to rotate · scroll or pinch to zoom
        </p>
      </div>

      <div class="col-span-12 md:col-span-5">
        <div class="rounded-card border border-primary/10 bg-surface-raised p-6">
          <p class="text-xs text-secondary">Example specifications</p>
          <div class="mt-4">
            <StatGroup stats={specs} />
          </div>
          <p class="mt-4 text-sm text-secondary">
            Specifications above are illustrative — refer to your specific
            graphics card's documentation for exact values.
          </p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
