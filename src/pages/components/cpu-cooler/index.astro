---
// ============================================================
// FILE: src/pages/components/cpu-cooler/index.astro
// Phase 6 (CPU Cooler) — mirrors the established component-page
// structure exactly (viewer 7/12 + specs 5/12 at md:).
// ============================================================
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatGroup from '../../../components/StatGroup.astro';
import Model3D from '../../../components/Model3D.astro';

const specs = [
  { label: 'Type', value: 'Air tower cooler' },
  { label: 'Height', value: '158mm' },
  { label: 'Fan size', value: '120mm' },
  { label: 'Socket compatibility', value: 'LGA1700, AM5' },
  { label: 'Rated TDP', value: '180W' },
];
---

<BaseLayout title="CPU Cooler — Component library — PC Customization Manual">
  <article class="mx-auto w-full max-w-content px-6 py-12 md:py-16">
    <div class="grid grid-cols-12 gap-6">
      <header class="col-span-12">
        <p class="font-mono text-xs text-secondary">Component 3 of 8</p>
        <h1 class="mt-4 text-2xl font-medium md:text-3xl">CPU Cooler</h1>
        <p class="mt-4 max-w-2xl text-lg text-secondary">
          The cooler pulls heat away from the CPU and keeps it from throttling
          under load. How evenly it seats against the CPU matters as much as
          the cooler itself — an uneven mount can undo an otherwise perfect
          installation.
        </p>
      </header>

      <div class="col-span-12 md:col-span-7">
        <Model3D
          geometry="cpuCooler"
          label="Stylized 3D model of an air-tower CPU cooler showing the flat contact base plate, three vertical heat pipes rising into the fin stack, and a fan disc mounted on one side of the fin stack"
        />
        <p class="mt-2 text-xs text-secondary">
          Drag to rotate · scroll or pinch to zoom
        </p>
      </div>

      <div class="col-span-12 md:col-span-5">
        <div class="rounded-card border border-primary/10 bg-surface-raised p-6">
          <p class="text-xs text-secondary">Example specifications</p>
          <div class="mt-4">
            <StatGroup stats={specs} />
          </div>
          <p class="mt-4 text-sm text-secondary">
            Specifications above are illustrative — refer to your specific
            cooler's documentation for exact values.
          </p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
