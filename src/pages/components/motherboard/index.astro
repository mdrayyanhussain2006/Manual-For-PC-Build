---
// ============================================================
// FILE: src/pages/components/motherboard/index.astro
// Phase 4 — ONLY change: eyebrow updated to "Component 5 of 8"
// to reflect build order. Nothing else on this page changes.
// ============================================================
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatGroup from '../../../components/StatGroup.astro';
import Model3D from '../../../components/Model3D.astro';

const specs = [
  { label: 'Form factor', value: 'ATX' },
  { label: 'Socket', value: 'LGA1700' },
  { label: 'Memory slots', value: '4 × DDR5' },
  { label: 'Max memory', value: '128GB' },
  { label: 'Expansion slots', value: '1× PCIe 5.0 x16' },
];
---

<BaseLayout title="Motherboard — Component library — PC Customization Manual">
  <article class="mx-auto w-full max-w-content px-6 py-12 md:py-16">
    <div class="grid grid-cols-12 gap-6">
      <header class="col-span-12">
        <p class="font-mono text-xs text-secondary">Component 5 of 8</p>
        <h1 class="mt-4 text-2xl font-medium md:text-3xl">Motherboard</h1>
        <p class="mt-4 max-w-2xl text-lg text-secondary">
          The motherboard is the foundation every other component connects to —
          CPU, RAM, storage, GPU, and every front-panel and power cable route
          back to it. Getting its layout right before you start is the
          difference between a smooth build and a frustrating one.
        </p>
      </header>

      <div class="col-span-12 md:col-span-7">
        <Model3D
          geometry="motherboard"
          label="Stylized 3D model of a motherboard showing the CPU socket, four RAM slots, a PCIe expansion slot, and the rear I/O panel"
        />
        <p class="mt-2 text-xs text-secondary">
          Drag to rotate · scroll or pinch to zoom
        </p>
      </div>

      <div class="col-span-12 md:col-span-5">
        <div class="rounded-card border border-primary/10 bg-surface-raised p-6">
          <p class="text-xs text-secondary">Example specifications</p>
          <div class="mt-4">
            <StatGroup stats={specs} />
          </div>
          <p class="mt-4 text-sm text-secondary">
            Specifications above are illustrative — refer to your specific
            board's documentation for exact values.
          </p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
