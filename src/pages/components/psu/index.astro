---
// ============================================================
// FILE: src/pages/components/psu/index.astro
// Phase 9 (PSU) — mirrors the established component-page
// structure exactly (viewer 7/12 + specs 5/12 at md:).
// Copy transcribed character-for-character from the prompt.
// ============================================================
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatGroup from '../../../components/StatGroup.astro';
import Model3D from '../../../components/Model3D.astro';

const specs = [
  { label: 'Wattage', value: '650W' },
  { label: 'Efficiency rating', value: '80 Plus Gold' },
  { label: 'Modularity', value: 'Fully modular' },
  { label: 'Form factor', value: 'ATX' },
  { label: 'Fan size', value: '120mm' },
];
---

<BaseLayout title="PSU — Component library — PC Customization Manual">
  <article class="mx-auto w-full max-w-content px-6 py-12 md:py-16">
    <div class="grid grid-cols-12 gap-6">
      <header class="col-span-12">
        <p class="font-mono text-xs text-secondary">Component 6 of 8</p>
        <h1 class="mt-4 text-2xl font-medium md:text-3xl">PSU</h1>
        <p class="mt-4 max-w-2xl text-lg text-secondary">
          The PSU converts wall power into the clean, stable voltages every
          other component depends on. Getting its orientation and cable routing
          right now saves a lot of backtracking once the case starts filling up.
        </p>
      </header>

      <div class="col-span-12 md:col-span-7">
        <Model3D
          geometry="psu"
          label="Stylized 3D model of a PSU showing the rectangular housing, a fan disc sitting flush on the top face, and the modular connector panel on one end of the housing"
        />
        <p class="mt-2 text-xs text-secondary">
          Drag to rotate · scroll or pinch to zoom
        </p>
      </div>

      <div class="col-span-12 md:col-span-5">
        <div class="rounded-card border border-primary/10 bg-surface-raised p-6">
          <p class="text-xs text-secondary">Example specifications</p>
          <div class="mt-4">
            <StatGroup stats={specs} />
          </div>
          <p class="mt-4 text-sm text-secondary">
            Specifications above are illustrative — refer to your specific
            power supply's documentation for exact values.
          </p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
