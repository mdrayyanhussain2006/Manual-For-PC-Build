---
// ============================================================
// FILE: src/pages/components/index.astro
// Component library index displaying all 12 canonical components
// ============================================================
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllComponents } from '../../lib/3d/ComponentRegistry';

const componentsList = getAllComponents();
---

<BaseLayout title="Component library — PC Customization Manual">
  <section class="mx-auto w-full max-w-content px-6 py-12 md:py-16">
    <div class="max-w-3xl">
      <p class="inline-flex items-center gap-2 rounded-badge border border-primary/10 bg-surface-raised px-2.5 py-1 font-mono text-xs text-secondary">
        <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        12 Components Available
      </p>
      <h1 class="mt-4 text-2xl font-medium md:text-3xl">Component Library</h1>
      <p class="mt-3 text-lg text-secondary">
        Twelve distinct hardware components make up the modern PC ecosystem. Explore each part in interactive 3D with X-Ray inspection, exploded disassembly views, and pinpoint hardware annotations.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-12 gap-6">
      {componentsList.map((item, index) => (
        <a
          href={item.route}
          class="group col-span-12 flex flex-col justify-between rounded-card border border-primary/10 bg-surface p-6 transition-all hover:border-accent/40 hover:bg-surface-raised sm:col-span-6 lg:col-span-4"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs text-secondary">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="rounded bg-surface-raised px-2 py-0.5 font-mono text-[10px] text-secondary group-hover:text-accent">
                {item.category}
              </span>
            </div>
            <h2 class="mt-3 text-base font-medium text-primary group-hover:text-accent transition-colors">
              {item.displayName}
            </h2>
            <p class="mt-2 text-xs text-secondary line-clamp-2 leading-relaxed">
              {item.description}
            </p>
          </div>

          <div class="mt-6 flex items-center gap-2 pt-4 border-t border-primary/5 font-mono text-[11px] text-accent">
            <span>Inspect in 3D</span>
            <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
