---
// ============================================================
// FILE: src/pages/components/case/index.astro
// Phase 4 — Case component page. Mirrors the Motherboard page
// structure exactly (viewer 7/12 + specs 5/12 at md:).
// ============================================================
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatGroup from '../../../components/StatGroup.astro';
import Model3D from '../../../components/Model3D.astro';

const specs = [
  { label: 'Form factor support', value: 'ATX, Micro-ATX, Mini-ITX' },
  { label: 'Max GPU length', value: '330mm' },
  { label: 'Drive bays', value: '2× 3.5″, 2× 2.5″' },
  { label: 'Front I/O', value: 'USB-A, USB-C, 3.5mm audio' },
  { label: 'Included fans', value: '2' },
];
---

<BaseLayout title="Case — Component library — PC Customization Manual">
  <article class="mx-auto w-full max-w-content px-6 py-12 md:py-16">
    <div class="grid grid-cols-12 gap-6">
      <header class="col-span-12">
        <p class="font-mono text-xs text-secondary">Component 1 of 8</p>
        <h1 class="mt-4 text-2xl font-medium md:text-3xl">Case</h1>
        <p class="mt-4 max-w-2xl text-lg text-secondary">
          The case houses and protects every other component, and its layout
          determines how much room you have to work with — and how clean your
          cable routing can be. Get familiar with its standoffs and headers
          before anything else goes in.
        </p>
      </header>

      <div class="col-span-12 md:col-span-7">
        <Model3D
          geometry="case"
          label="Stylized 3D model of a PC case with the side panel removed, showing the open chassis, the motherboard standoff tray, the front-panel header area, and the removed side panel set aside"
        />
        <p class="mt-2 text-xs text-secondary">
          Drag to rotate · scroll or pinch to zoom
        </p>
      </div>

      <div class="col-span-12 md:col-span-5">
        <div class="rounded-card border border-primary/10 bg-surface-raised p-6">
          <p class="text-xs text-secondary">Example specifications</p>
          <div class="mt-4">
            <StatGroup stats={specs} />
          </div>
          <p class="mt-4 text-sm text-secondary">
            Specifications above are illustrative — refer to your specific
            case's documentation for exact values.
          </p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
